    "import matplotlib.pyplot as plt\n",
    "\n",
    "x=[2020, 2021, 2022, 2023, 2024]\n",
    "y=[10, 15, 20, 25, 20]\n",
    "plt.plot(x, y)\n",
    "plt.xlabel('Year')\n",
    "plt.ylabel('Student Intake')\n",
    "plt.title('Student Intake Over the Years')\n",
    "plt.show()"
